{
    "name": "melasistema/mela-cms",
    "description": "MelaCMS core: an agentic-coding-friendly CMS for Laravel built on Filament, Blade and Alpine.",
    "keywords": ["laravel", "cms", "filament", "multilanguage", "agentic"],
    "homepage": "https://github.com/melasistema/mela-cms",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Luca Visciola",
            "email": "melasistema@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Melasistema\\MelaCms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Melasistema\\MelaCms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "format": "pint",
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Melasistema\\MelaCms\\MelaCmsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
